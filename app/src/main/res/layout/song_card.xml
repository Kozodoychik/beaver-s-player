<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="25dp"
    android:layout_marginVertical="10dp" >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgSongArtwork"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="@string/song_artwork_description"
        app:srcCompat="@drawable/dummy_artwork"
        app:shapeAppearanceOverlay="@style/artworkImage" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/imgSongArtwork"
        android:layout_centerVertical="true" >

        <TextView
            android:id="@+id/lblSongName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/dummy_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblSongArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:text="@string/dummy_artist"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>